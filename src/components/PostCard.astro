---
interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
  section: string;
  thumbnail?: string;
}

const { title, description, date, href, section, thumbnail } = Astro.props;

// Per-section eyebrow accent. Astrophotography rides the core fire accent;
// the other sections keep the mockup's distinct hues for quick scanning.
const sectionColors: Record<string, string> = {
  astrophotography: 'text-fire',
  projects: 'text-emerald-400',
  'claudes-corner': 'text-violet-400',
  workshop: 'text-sky-400',
  'field-notes': 'text-rose-400',
};

const sectionLabels: Record<string, string> = {
  astrophotography: 'Astrophotography',
  projects: 'Projects',
  'claudes-corner': "Claude's Corner",
  workshop: 'Workshop',
  'field-notes': 'Field Notes',
};
---

<a href={href} class="group block brutal-hover">
  {thumbnail && (
    <div class="aspect-[3/2] overflow-hidden brutal-border mb-4">
      <img src={thumbnail} alt={title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
    </div>
  )}
  <span class={`font-mono text-[10px] tracking-[0.2em] uppercase ${sectionColors[section] || 'text-fire'}`}>
    {sectionLabels[section] || section}
  </span>
  <h3 class="font-display text-2xl text-white group-hover:text-fire transition-colors mt-2 mb-2 uppercase tracking-wide leading-none">{title}</h3>
  <p class="text-chalk-dim text-sm leading-relaxed font-light line-clamp-2 mb-3">{description}</p>
  <time class="font-mono text-[10px] text-steel-light" datetime={date.toISOString()}>
    {date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
  </time>
</a>
