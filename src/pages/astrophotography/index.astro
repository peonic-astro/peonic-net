---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('astrophotography', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Astrophotography" description="Narrowband imaging from a Bortle 6 backyard in Suffolk, UK.">
  <SectionHeader
    title="Astrophotography"
    subtitle="Narrowband imaging from a Bortle 6 backyard in Suffolk, UK. Ha, OIII, SII - photon by photon."
  >
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
        {posts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            href={`/astrophotography/${post.id}`}
            section="astrophotography"
            thumbnail={post.data.thumbnail || post.data.hero_image}
          />
        ))}
      </div>
    ) : (
      <p class="font-mono text-sm text-chalk-dim py-20 text-center uppercase tracking-wider">Gallery coming soon.</p>
    )}
  </SectionHeader>
</BaseLayout>
