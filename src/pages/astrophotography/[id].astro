---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('astrophotography');
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

// Structured data for search engines
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  name: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  author: { '@type': 'Person', name: 'Chris Belton', url: 'https://peonic.net/about/' },
  contentLocation: d.location || 'Suffolk, UK',
  url: new URL(`/astrophotography/${post.id}/`, Astro.site).toString(),
  ...(d.hero_image ? { contentUrl: new URL(d.hero_image, Astro.site).toString() } : {}),
};
---

<BaseLayout title={d.title} description={d.description} ogImage={d.hero_image ? new URL(d.hero_image, Astro.site).toString() : undefined} ogType="article" jsonLd={jsonLd}>
  <article class="max-w-4xl mx-auto px-6 lg:px-12 py-16">
    <header class="mb-12">
      <p class="font-mono text-xs text-fire tracking-[0.3em] uppercase mb-6">Astrophotography</p>
      <h1 class="font-display text-5xl md:text-7xl text-white mb-6 uppercase tracking-wide leading-[0.9]">{d.title}</h1>
      <div class="editorial-line w-24 mb-6"></div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-steel-light">
        <time datetime={d.date.toISOString()}>
          {d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        <span class="text-steel">/</span>
        <span>{d.constellation}</span>
        <span class="text-steel">/</span>
        <span>{d.palette} palette</span>
        <span class="text-steel">/</span>
        <span>{d.total_integration_hours}h total integration</span>
      </div>
    </header>

    {d.hero_image && (
      <div class="overflow-hidden brutal-border mb-12">
        <img src={d.hero_image} alt={d.title} class="lightbox w-full h-full object-cover" />
      </div>
    )}

    <!-- Capture data panel -->
    <div class="brutal-border bg-void-light p-6 mb-12">
      <h2 class="font-mono text-fire text-[10px] uppercase tracking-[0.3em] mb-6">Capture Data</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-sm">
        <div>
          <span class="font-mono text-[10px] text-steel-light uppercase tracking-wider block mb-1">Target</span>
          <span class="text-white font-medium">{d.target}</span>
        </div>
        <div>
          <span class="font-mono text-[10px] text-steel-light uppercase tracking-wider block mb-1">Telescope</span>
          <span class="text-white font-medium">{d.telescope}</span>
        </div>
        <div>
          <span class="font-mono text-[10px] text-steel-light uppercase tracking-wider block mb-1">Camera</span>
          <span class="text-white font-medium">{d.camera}</span>
        </div>
        <div>
          <span class="font-mono text-[10px] text-steel-light uppercase tracking-wider block mb-1">Mount</span>
          <span class="text-white font-medium">{d.mount}</span>
        </div>
      </div>

      <!-- Integration breakdown per filter -->
      <div class="mt-6 pt-6 border-t-2 border-steel">
        <span class="font-mono text-[10px] text-steel-light uppercase tracking-wider block mb-3">Integration</span>
        <div class="flex flex-wrap gap-3">
          {Object.entries(d.integration).map(([filter, data]) => (
            <div class="border border-steel bg-void px-3 py-2 text-sm">
              <span class="font-mono text-fire font-bold">{filter}</span>
              <span class="text-chalk-dim ml-2">{data.frames} &times; {data.exposure}s</span>
              <span class="text-white ml-1">({data.total_hours}h)</span>
            </div>
          ))}
        </div>
      </div>

      {d.catalogue.length > 0 && (
        <div class="mt-4 font-mono text-[11px] text-chalk-dim uppercase tracking-wider">
          Catalogue: {d.catalogue.join(', ')}
        </div>
      )}
    </div>

    <!-- Post body -->
    <div class="prose max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
