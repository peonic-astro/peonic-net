---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('field-notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Field Notes" description="Short-form posts, random discoveries, opinions, and learning in public.">
  <SectionHeader
    title="Field Notes"
    subtitle="Short-form posts. Learning in public, random discoveries, opinions, rants."
  >
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
        {posts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            href={`/field-notes/${post.id}`}
            section="field-notes"
            thumbnail={post.data.thumbnail || post.data.hero_image}
          />
        ))}
      </div>
    ) : (
      <p class="font-mono text-sm text-chalk-dim py-20 text-center uppercase tracking-wider">Field notes coming soon.</p>
    )}
  </SectionHeader>
</BaseLayout>
