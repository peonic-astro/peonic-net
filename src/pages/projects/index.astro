---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Brutalist status pill per project state.
const statusBadge: Record<string, string> = {
  active: 'bg-emerald-500/10 text-emerald-400 border-2 border-emerald-500/30',
  complete: 'bg-sky-500/10 text-sky-400 border-2 border-sky-500/30',
  archived: 'bg-steel/30 text-chalk-dim border-2 border-steel',
  planned: 'bg-fire/10 text-fire border-2 border-fire/30',
};
---

<BaseLayout title="Projects" description="AI tinkering, smart home builds, and assorted rabbit holes.">
  <SectionHeader
    title="Projects"
    subtitle="AI tinkering, smart home builds, and whatever rabbit hole I've fallen into this week."
  >
    {posts.length > 0 ? (
      <div class="divide-y-2 divide-steel">
        {posts.map(post => (
          <a href={`/projects/${post.id}`} class="group block py-8 card-hover brutal-hover">
            <div class="grid grid-cols-12 gap-6 items-start">
              {post.data.hero_image && (
                <div class="col-span-12 md:col-span-4 overflow-hidden brutal-border">
                  <img src={post.data.hero_image} alt={post.data.title} class="card-image w-full aspect-[16/10] object-cover transition-transform duration-500" loading="lazy" />
                </div>
              )}
              <div class="col-span-12 md:col-span-6">
                <div class="flex items-center gap-3 mb-2">
                  <h3 class="font-display text-3xl text-white group-hover:text-fire transition-colors uppercase tracking-wide leading-none">{post.data.title}</h3>
                  <span class={`font-mono text-[10px] px-2 py-0.5 uppercase ${statusBadge[post.data.status]}`}>{post.data.status}</span>
                </div>
                <p class="text-chalk-dim text-sm leading-relaxed mb-4 font-light">{post.data.description}</p>
                {post.data.tech.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {post.data.tech.map((t: string) => (
                      <span class="font-mono text-[10px] px-2 py-1 bg-steel/50 text-chalk-dim border border-steel">{t}</span>
                    ))}
                  </div>
                )}
              </div>
              <div class="col-span-12 md:col-span-2 md:text-right">
                <time class="font-mono text-[10px] text-steel-light" datetime={post.data.date.toISOString()}>{post.data.date.getFullYear()}</time>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="font-mono text-sm text-chalk-dim py-20 text-center uppercase tracking-wider">Projects showcase coming soon.</p>
    )}
  </SectionHeader>
</BaseLayout>
