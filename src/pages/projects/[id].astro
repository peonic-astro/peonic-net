---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('projects');
  return posts.map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  author: { '@type': 'Person', name: 'Chris Belton', url: 'https://peonic.net/about/' },
  url: new URL(`/projects/${post.id}/`, Astro.site).toString(),
  ...(d.hero_image ? { image: new URL(d.hero_image, Astro.site).toString() } : {}),
};
const ogImage = d.hero_image ? new URL(d.hero_image, Astro.site).toString() : undefined;

// Brutalist status pill per project state.
const statusBadge: Record<string, string> = {
  active: 'bg-emerald-500/10 text-emerald-400 border-2 border-emerald-500/30',
  complete: 'bg-sky-500/10 text-sky-400 border-2 border-sky-500/30',
  archived: 'bg-steel/30 text-chalk-dim border-2 border-steel',
  planned: 'bg-fire/10 text-fire border-2 border-fire/30',
};
---

<BaseLayout title={d.title} description={d.description} ogImage={ogImage} ogType="article" jsonLd={jsonLd}>
  <article class="max-w-4xl mx-auto px-6 lg:px-12 py-16">
    <header class="mb-12">
      <p class="font-mono text-xs text-fire tracking-[0.3em] uppercase mb-6">Projects</p>
      <div class="flex flex-wrap items-center gap-4 mb-6">
        <h1 class="font-display text-5xl md:text-7xl text-white uppercase tracking-wide leading-[0.9]">{d.title}</h1>
        <span class={`font-mono text-[10px] px-2 py-0.5 uppercase ${statusBadge[d.status]}`}>{d.status}</span>
      </div>
      <div class="editorial-line w-24 mb-6"></div>
      {d.tech.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {d.tech.map((t: string) => (
            <span class="font-mono text-[10px] px-2 py-1 bg-steel/50 text-chalk-dim border border-steel uppercase tracking-wider">{t}</span>
          ))}
        </div>
      )}
    </header>

    {d.hero_image && (
      <div class="aspect-[3/1] overflow-hidden brutal-border mb-12">
        <img src={d.hero_image} alt={d.title} class="w-full h-full object-cover" />
      </div>
    )}

    <div class="prose max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
