---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
  // When true, <main> sits flush under the fixed nav so a full-bleed hero can
  // run edge-to-edge. Interior pages leave it false and get top padding.
  fullBleed?: boolean;
}

const {
  title,
  description = 'Astrophotography, projects, and tinkering by Koz.',
  ogImage,
  ogType = 'website',
  jsonLd,
  fullBleed = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Fall back to a default social image if none provided
const socialImage = ogImage || new URL('/images/hero/horsehead.jpg', Astro.site).toString();

// Top nav. `match` decides which link burns fire for the current section.
const pathname = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  { href: '/astrophotography', label: 'Astrophotography', match: (p: string) => p.startsWith('/astrophotography') },
  { href: '/projects', label: 'Projects', match: (p: string) => p.startsWith('/projects') },
  { href: '/claudes-corner', label: "Claude's Corner", match: (p: string) => p.startsWith('/claudes-corner') },
  { href: '/field-notes', label: 'Field Notes', match: (p: string) => p.startsWith('/field-notes') },
  { href: '/about', label: 'About', match: (p: string) => p.startsWith('/about') },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title} | Peonic</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Peonic`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Peonic" />

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Peonic`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Structured data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Fonts: Bebas Neue (display), Archivo (body), Space Mono (labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Bebas+Neue&family=Archivo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Film grain over the entire viewport -->
    <div class="grain"></div>

    <!-- NAV: fixed, segmented, brutalist -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-void border-b-2 border-steel">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
        <div class="flex items-center justify-between h-20">
          <a href="/" class="font-display text-3xl tracking-wider text-white">PEONIC</a>

          <!-- Desktop links -->
          <div class="hidden md:flex items-center gap-0">
            {navLinks.map((link, i) => {
              const active = link.match(pathname);
              return (
                <a
                  href={link.href}
                  class:list={[
                    'font-mono text-xs px-4 py-2 uppercase tracking-wider border-l-2 border-steel brutal-hover',
                    i === navLinks.length - 1 && 'border-r-2',
                    active ? 'text-fire' : 'text-chalk-dim hover:text-white',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >{link.label}</a>
              );
            })}
          </div>

          <!-- Mobile menu button -->
          <button id="mobile-menu-btn" class="md:hidden p-2 text-chalk-dim hover:text-fire brutal-hover" aria-label="Menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t-2 border-steel bg-void">
        <div class="flex flex-col">
          {navLinks.map((link) => {
            const active = link.match(pathname);
            return (
              <a
                href={link.href}
                class:list={[
                  'font-mono text-xs px-6 py-4 uppercase tracking-wider border-b border-steel brutal-hover',
                  active ? 'text-fire' : 'text-chalk-dim hover:text-white',
                ]}
                aria-current={active ? 'page' : undefined}
              >{link.label}</a>
            );
          })}
        </div>
      </div>
    </nav>

    <main class:list={['flex-1', !fullBleed && 'pt-20']}>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="border-t-2 border-steel bg-void-light">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-12 py-16">
        <div class="grid grid-cols-12 gap-6">
          <div class="col-span-12 md:col-span-6">
            <p class="font-display text-5xl text-white mb-4 tracking-wide">PEONIC</p>
            <p class="text-chalk-dim text-sm max-w-sm font-light">Astrophotography, AI, and infrastructure. Shot and built from Suffolk, UK.</p>
          </div>
          <div class="col-span-6 md:col-span-3">
            <p class="font-mono text-[10px] text-fire tracking-[0.2em] uppercase mb-4">Sections</p>
            <ul class="space-y-2 text-sm text-chalk-dim">
              <li><a href="/astrophotography" class="hover:text-white brutal-hover">Astrophotography</a></li>
              <li><a href="/projects" class="hover:text-white brutal-hover">Projects</a></li>
              <li><a href="/claudes-corner" class="hover:text-white brutal-hover">Claude's Corner</a></li>
              <li><a href="/field-notes" class="hover:text-white brutal-hover">Field Notes</a></li>
            </ul>
          </div>
          <div class="col-span-6 md:col-span-3">
            <p class="font-mono text-[10px] text-fire tracking-[0.2em] uppercase mb-4">Elsewhere</p>
            <ul class="space-y-2 text-sm text-chalk-dim">
              <li><a href="https://github.com/peonic-astro" class="hover:text-white brutal-hover">GitHub</a></li>
              <li><a href="/about" class="hover:text-white brutal-hover">About</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 pt-8 border-t-2 border-steel font-mono text-[10px] text-steel-light uppercase tracking-[0.2em]">
          &copy; {new Date().getFullYear()} Peonic. Built with Astro, deployed on Cloudflare.
        </div>
      </div>
    </footer>

    <!-- Mobile menu + lightbox scripts -->
    <script>
      // Mobile menu
      const menuBtn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });

      // Lightbox with zoom and pan
      const overlay = document.getElementById('lightbox-overlay') as HTMLElement;
      const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const lbCaption = document.getElementById('lightbox-caption') as HTMLElement;
      const lbContainer = document.getElementById('lightbox-container') as HTMLElement;

      let scale = 1;
      let panX = 0;
      let panY = 0;
      let isDragging = false;
      let dragStartX = 0;
      let dragStartY = 0;
      let panStartX = 0;
      let panStartY = 0;

      function updateTransform() {
        lbImg.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
      }

      function resetZoom() {
        scale = 1;
        panX = 0;
        panY = 0;
        updateTransform();
        lbImg.style.cursor = 'zoom-in';
      }

      function closeLightbox() {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
        lbImg.src = '';
        resetZoom();
      }

      document.querySelectorAll<HTMLImageElement>('.lightbox').forEach(img => {
        img.style.cursor = 'zoom-in';
        img.addEventListener('click', () => {
          lbImg.src = img.src;
          lbCaption.textContent = img.alt || '';
          overlay.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          resetZoom();
        });
      });

      // Mouse wheel zoom
      lbContainer?.addEventListener('wheel', (e) => {
        e.preventDefault();
        const delta = e.deltaY > 0 ? 0.8 : 1.25;
        const newScale = Math.min(Math.max(scale * delta, 1), 10);

        if (newScale === 1) {
          resetZoom();
        } else {
          // Zoom towards mouse position
          const rect = lbImg.getBoundingClientRect();
          const cx = e.clientX - rect.left - rect.width / 2;
          const cy = e.clientY - rect.top - rect.height / 2;
          const ratio = 1 - newScale / scale;
          panX += cx * ratio;
          panY += cy * ratio;
          scale = newScale;
          updateTransform();
          lbImg.style.cursor = scale > 1 ? 'grab' : 'zoom-in';
        }
      }, { passive: false });

      // Click to toggle zoom
      lbImg?.addEventListener('click', (e) => {
        if (isDragging) return;
        e.stopPropagation();
        if (scale === 1) {
          // Zoom to 3x at click position
          const rect = lbImg.getBoundingClientRect();
          const cx = e.clientX - rect.left - rect.width / 2;
          const cy = e.clientY - rect.top - rect.height / 2;
          scale = 3;
          panX = -cx * 2;
          panY = -cy * 2;
          updateTransform();
          lbImg.style.cursor = 'grab';
        } else {
          resetZoom();
        }
      });

      // Drag to pan when zoomed
      lbImg?.addEventListener('mousedown', (e) => {
        if (scale <= 1) return;
        e.preventDefault();
        isDragging = false;
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        panStartX = panX;
        panStartY = panY;
        lbImg.style.cursor = 'grabbing';

        const onMove = (ev: MouseEvent) => {
          const dx = ev.clientX - dragStartX;
          const dy = ev.clientY - dragStartY;
          if (Math.abs(dx) > 3 || Math.abs(dy) > 3) isDragging = true;
          panX = panStartX + dx;
          panY = panStartY + dy;
          updateTransform();
        };

        const onUp = () => {
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
          lbImg.style.cursor = scale > 1 ? 'grab' : 'zoom-in';
          // Reset isDragging after click event fires
          setTimeout(() => { isDragging = false; }, 0);
        };

        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      });

      // Close on overlay background click or close button
      overlay?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target === overlay || target === lbContainer || target.id === 'lightbox-close') {
          closeLightbox();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (overlay.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeLightbox();
      });
    </script>

    <!-- Lightbox overlay -->
    <div id="lightbox-overlay" class="hidden fixed inset-0 z-[100] bg-black/95 flex flex-col items-center justify-center">
      <button id="lightbox-close" class="absolute top-4 right-4 text-chalk-dim hover:text-fire text-4xl leading-none z-10 brutal-hover">&times;</button>
      <div id="lightbox-container" class="flex-1 w-full flex items-center justify-center overflow-hidden">
        <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-[95vw] object-contain transition-transform duration-150 ease-out select-none brutal-border" draggable="false" />
      </div>
      <p id="lightbox-caption" class="text-chalk-dim font-mono text-xs py-3 text-center max-w-2xl"></p>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
